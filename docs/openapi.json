{
  "openapi": "3.1.0",
  "info": {
    "title": "MediSphere AI — Enterprise Hospital Operations Intelligence API",
    "version": "1.0.0",
    "description": "Production REST API for MediSphere AI hospital operations, multi-agent orchestration, bed management, and emergency response."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    },
    {
      "url": "https://medisphere-backend.onrender.com",
      "description": "Production Render Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check Endpoint",
        "operationId": "get_health_check",
        "responses": {
          "200": {
            "description": "System operational"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate Staff Member",
        "operationId": "login_for_access_token",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["username", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token generated successfully"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/v1/dashboard/stats": {
      "get": {
        "summary": "Get Executive Dashboard Telemetry Stats",
        "operationId": "get_dashboard_stats",
        "responses": {
          "200": {
            "description": "Telemetry metrics returned"
          }
        }
      }
    },
    "/api/v1/beds": {
      "get": {
        "summary": "List Ward Bed Capacities and States",
        "operationId": "list_beds",
        "responses": {
          "200": {
            "description": "Bed status matrix returned"
          }
        }
      }
    },
    "/api/v1/emergency": {
      "get": {
        "summary": "Get Live Emergency Department Queue",
        "operationId": "get_emergency_queue",
        "responses": {
          "200": {
            "description": "Emergency queue returned"
          }
        }
      }
    }
  }
}
